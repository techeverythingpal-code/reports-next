# Copy this file to .env.local and fill in your own values. Never commit .env.local.

# Same database the Laravel app uses (XAMPP MySQL locally).
# Format: mysql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=mysql://root:@127.0.0.1:3306/reportsdb

# Secret used to sign the login cookie. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SESSION_SECRET=
